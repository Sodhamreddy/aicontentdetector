{
  "name": "kleza-content-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --restart-tries 5 --restart-after 2000 \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server.mjs",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node tests/humanizer.test.mjs && node tests/llm.test.mjs && node tests/history.test.mjs && node tests/extract.test.mjs && node tests/plagiarism.test.mjs && node tests/offline.test.mjs && node tests/smoke.mjs",
    "test:humanizer": "node tests/humanizer.test.mjs",
    "test:llm": "node tests/llm.test.mjs",
    "test:history": "node tests/history.test.mjs",
    "test:extract": "node tests/extract.test.mjs",
    "test:plagiarism": "node tests/plagiarism.test.mjs",
    "test:detector": "node tests/detector.test.mjs",
    "test:security": "node tests/security.test.mjs",
    "test:neural": "node tests/neural.test.mjs",
    "test:offline": "node tests/offline.test.mjs",
    "test:ui": "npm run build && node tests/ui.test.mjs",
    "detector:benchmark": "node scripts/detector.mjs benchmark",
    "detector:train": "node scripts/detector.mjs train"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "better-sqlite3": "12.11.1",
    "cheerio": "1.2.0",
    "cors": "2.8.6",
    "docx": "9.7.2",
    "express": "5.2.1",
    "mammoth": "1.12.3",
    "multer": "2.4.0",
    "onnxruntime-web": "1.30.0",
    "pdf-parse": "2.4.5",
    "pdf-to-img": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "vite": "8.3.0",
    "word-extractor": "1.0.4",
    "wordnet-db": "^3.1.14"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "concurrently": "10.0.5",
    "pdf-lib": "1.17.1",
    "puppeteer-core": "25.12.0"
  }
}
