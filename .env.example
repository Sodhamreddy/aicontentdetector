PORT=3001

# Optional: AI rewriting through any OpenAI-compatible service. Leave empty to use the built-in local editor only
# (nothing leaves this machine). When set, the text being rewritten is sent to that service. If it fails, the
# built-in editor does the rewrite instead.
#   groq        free tier, key at https://console.groq.com/keys             (default model openai/gpt-oss-120b)
#   openrouter  free ":free" models, key at https://openrouter.ai/keys      (default meta-llama/llama-3.3-70b-instruct:free)
#   gemini      free tier, key at https://aistudio.google.com               (default gemini-3.7-flash)
#   ollama      runs on your own machine, no key; install from https://ollama.com and pull a model
# Never paste a real key into a chat, issue or commit message.
LLM_PROVIDER=
LLM_API_KEY=
# Only to override the preset's endpoint or model:
LLM_BASE_URL=
LLM_MODEL=
# How hard the rewrite tries: stop once the AI score is under this (0.15 = 15%), after at most this many attempts.
HUMANIZE_TARGET=0.15
HUMANIZE_MAX_ATTEMPTS=5
# The rewrite must keep at least this share of the original words (0.9 = 90%), so a low score cannot come from cutting content.
HUMANIZE_MIN_LENGTH=0.9

# Optional: web search for the plagiarism checker (off until set). Only short phrases from the text are sent.
#   searxng a search engine you run yourself, free and no key: SEARCH_PROVIDER=searxng and SEARCH_BASE_URL=http://localhost:8080 (see the README)
#   brave   free plan (about 2,000 searches a month), key at https://brave.com/search/api
#   google  Programmable Search (about 100 free searches a day): also needs SEARCH_CX
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_CX=

# The detector makes no network request for its data: training data is read from detector/*.jsonl and the neural
# models from data/models, both into memory. Without the LLM settings above, the humanizer is a built-in local engine.
# Set to off to skip the neural models entirely (style-only scoring).
KLEZA_NEURAL=on

# --- Deployment ---
# Set these on the host (never commit real values). NODE_ENV=production serves the built UI from the same server.
NODE_ENV=production
# Behind a proxy or platform load balancer (Render, Fly, Railway, nginx): number of proxies, so rate limits see the real client IP.
TRUST_PROXY=1
# Require this token for analyze/rewrite calls (recommended for any public deployment).
KLEZA_ACCESS_TOKEN=
# Only if a different site calls the API: comma-separated allowed origins.
CORS_ORIGIN=
# Requests per minute per client: all routes, and the heavy ones (analyze, rewrite, upload, url).
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_HEAVY_PER_MIN=60
# Where the SQLite database lives. The models folder is expected next to it (data/models).
# KLEZA_DB_PATH=/app/data/kleza.db
